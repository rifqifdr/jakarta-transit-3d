# Copy to `.env` and fill in. Only the first is needed to run the app.

# Mapbox GL, for the basemap. A default public token from
# https://account.mapbox.com works. It is compiled into the browser bundle —
# that is how Mapbox GL works and cannot be avoided — so for a deployed site
# use a *separate* public token with a URL restriction set to your domain,
# never the one you develop with.
MAPBOX_ACCESS_TOKEN=pk.your_token_here

# Everything below is only needed to rebuild the data, not to run the app.

# Plane, for the issue tracker scripts in scripts/plane*.mjs.
PLANE_API_TOKEN=

# Transitland, for `npm run ingest -- --source=walk`, which routes the walk
# table through their hosted Valhalla. Sent as a header, never in the query
# string — as a parameter it ends up in logs.
TRANSITLAND_API_TOKEN=
TRANSITLAND_ROUTING_API=
