# Cache rules, honoured by both Netlify and Cloudflare Pages. Copied into
# dist/ by Vite along with everything else in public/.
#
# The order matters: the first matching rule wins, so the one mutable file has
# to be listed before the directory it lives in.

# The only file in the build that is not content-hashed. Everything else is
# discovered through it, so a stale one pins a visitor to an old dataset.
/artifacts/manifest.json
  Cache-Control: public, max-age=0, must-revalidate

# Content-hashed by `npm run transform`: the filename changes when the bytes
# do, so these can be cached until the heat death of the browser.
/artifacts/*
  Cache-Control: public, max-age=31536000, immutable

# Content-hashed by Vite.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# The legacy bus-only bundle, reachable at ?data=legacy. Not hashed, so it
# gets a day rather than a year.
/data/*
  Cache-Control: public, max-age=86400

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
